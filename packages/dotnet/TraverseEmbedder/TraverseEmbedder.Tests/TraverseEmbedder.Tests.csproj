<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <ProjectReference Include="../TraverseEmbedder/TraverseEmbedder.csproj" />
  </ItemGroup>
  <!--
    Decision 111: build the traverse-dotnet-host model engine for this machine
    into the test output directory, so the model tests load the identical Rust
    code the NuGet package ships under runtimes/<rid>/native/.
  -->
  <Target Name="BuildTraverseDotnetHost" AfterTargets="Build" Condition="'$(TraverseSkipNativeModelHost)' != 'true'">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../../../scripts/build_dotnet_host_native.sh&quot; &quot;$(MSBuildProjectDirectory)/$(OutDir)&quot;" />
  </Target>
</Project>
