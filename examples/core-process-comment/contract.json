            },
            "metadata": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "comment_policy": {
          "type": "object",
          "required": [
            "version",
            "max_body_length",
            "max_thread_depth",
            "actions"
          ],
