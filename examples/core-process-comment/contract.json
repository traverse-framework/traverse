              "type": "string"
            },
            "max_body_length": {
              "type": "integer",
              "minimum": 1
            },
            "max_thread_depth": {
              "type": "integer",
              "minimum": 1
            },
            "allowed_markups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mention_resolution": {
              "type": "string",
              "enum": [
                "strict",
                "permissive",
                "disabled"
              ]
            },
            "visibility_model": {
              "type": "string",
