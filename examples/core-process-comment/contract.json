        "resource": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "attributes": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        },
        "comment": {
          "type": "object",
