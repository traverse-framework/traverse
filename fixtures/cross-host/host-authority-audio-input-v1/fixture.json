{
  "kind": "host_authority_conformance_fixture",
  "fixture_version": "1.0.0",
  "authority": {
    "connector_id": "traverse.audio-input",
    "connector_version": "1.0.0",
    "wit_package": "traverse:audio-input@1.0.0",
    "wit_path": "contracts/connectors/traverse.audio-input/wit/capture.wit"
  },
  "governing_specs": [
    "140-host-authority-wit-adapters",
    "137-host-connector-command-dispatch"
  ],
  "operations": {
    "request_permission": "audio.permission.request",
    "capture_audio": "audio.capture"
  },
  "binding": {
    "binding_id": "default-audio",
    "config_ref": "audio-default"
  },
  "target_roles": {
    "activated": "Every target family for which the embedder under test has activated an adapter. Run the case once per family, substituting the family into each command's target_family.",
    "unadapted": "A target family with no activated adapter. Use the reserved value `unadapted`."
  },
  "binding_setups": {
    "activated_compatible": "One binding, compatible version, non-empty config_ref, explicitly activated.",
    "missing": "The manifest declares no binding for the connector.",
    "incompatible_version": "One binding whose version is not compatible with the installed connector.",
    "unconfigured": "One activated binding with an empty config_ref.",
    "unactivated": "One compatible, configured binding that the host never activated."
  },
  "adapter_failure_class_mapping": {
    "unbound": "unbound",
    "incompatible": "incompatible",
    "unconfigured": "unconfigured",
    "policy-denied": "policy_denied",
    "target-incompatible": "target_incompatible",
    "limit-exceeded": "input_limit_exceeded",
    "cancelled": "cancelled",
    "unavailable": "unavailable"
  },
  "adapter_call_rules": [
    "adapter_calls lists the WIT functions the dispatcher must invoke, in order; an empty list means the adapter MUST NOT be invoked.",
    "permission-status is host-internal (Spec 140); a dispatcher MAY call it for fail-fast evidence and runners MUST NOT assert on it.",
    "A capture call with cancelled_by_host true is interrupted by cancel(correlation-id) while in flight.",
    "host_private_diagnostic is injected by the adapter test double as native detail; it is not part of the WIT failure record."
  ],
  "compared_event_fields": [
    "kind",
    "schema_version",
    "event",
    "command_id",
    "correlation_id",
    "connector_id",
    "operation",
    "binding_id",
    "artifact_ref",
    "error_code"
  ],
  "cross_target_equivalence": {
    "rule": "For every case with target_role activated, the ordered events and result fields on every activated target family MUST be identical after removing target_family.",
    "ignored_fields": [
      "target_family"
    ]
  },
  "redaction": {
    "forbidden_public_substrings": [
      "/Users/",
      "/tmp/",
      "://",
      "device 0x",
      "Built-In",
      "token=",
      "abc123",
      "Library/Audio"
    ],
    "applies_to": [
      "events",
      "result",
      "error.message",
      "evidence"
    ]
  },
  "fr_013_categories": [
    "success",
    "binding_missing",
    "binding_incompatible",
    "binding_unconfigured",
    "binding_unactivated",
    "unsupported_target",
    "permission_granted",
    "permission_denied",
    "permission_unavailable",
    "limits",
    "cancellation",
    "idempotency",
    "redaction",
    "cross_target_ordered_events"
  ],
