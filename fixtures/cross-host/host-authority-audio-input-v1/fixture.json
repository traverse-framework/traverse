    {
      "id": "redaction_non_opaque_artifact_ref",
      "fr_013": [
        "redaction"
      ],
      "description": "An adapter that returns a path-shaped artifact-ref violates FR-011. Dispatch fails unavailable and never publishes the reference.",
      "target_role": "activated",
      "binding_setup": "activated_compatible",
      "steps": [
        {
          "command": {
            "command": "capture_audio",
            "command_id": "cmd-00000019",
            "correlation_id": "corr-00000019",
            "idempotency_key": "idem-redact-ref",
            "payload": {
              "max_duration_ms": 5000,
              "max_bytes": 1048576
            }
          },
          "adapter_calls": [
            {
              "function": "capture",
              "returns": {
